{
  "name": "mobile",
  "version": "1.0.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "node doctor-check.js",
    "check-deps": "expo install --check",
    "fix-deps": "expo install --fix",
    "health": "node doctor-check.js && node test-android-35.js",
    "termux:setup": "./termux-setup.sh",
    "termux:validate": "./termux-validate.sh",
    "termux:build": "./termux-build-apk.sh",
    "build:android": "eas build --platform android",
    "build:production": "eas build --platform android --profile production",
    "build:fix": "./build-android-fix.sh",
    "clean": "expo r -c"
  },
  "dependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.27.6",
    "@egjs/hammerjs": "^2.0.17",
    "@expo/config-plugins": "~10.1.1",
    "@expo/metro-runtime": "~5.0.4",
    "@expo/prebuild-config": "~9.0.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/native": "^6.0.0",
    "@react-navigation/stack": "^6.0.0",
    "@tanstack/react-query": "^5.82.0",
    "@types/hammerjs": "^2.0.46",
    "babel-preset-expo": "~13.0.0",
    "expo": "^53.0.20",
    "expo-blur": "^14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-doctor": "~1.13.5",
    "expo-keep-awake": "^14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-screen-orientation": "^8.1.7",
    "expo-splash-screen": "^0.30.10",
    "expo-status-bar": "~2.2.3",
    "hoist-non-react-statics": "^3.3.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-freeze": "^1.0.4",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.20.0",
    "@expo/cli": "^0.24.20",
    "@types/react": "~19.0.10",
    "metro": "^0.82.0",
    "metro-config": "^0.82.0",
    "metro-resolver": "^0.82.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "listUnknownPackages": false,
        "exclude": []
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": true
      }
    }
  }
}
