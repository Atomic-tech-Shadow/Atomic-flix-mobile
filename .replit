modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"
packages = ["eas-cli", "freetype", "imagemagick", "jq", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjdk11", "openjpeg", "tcl", "tk", "unzip", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Atomic Flix Dev"

[[workflows.workflow]]
name = "Atomic Flix Dev"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run web:replit"
waitForPort = 5000

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "build"]
