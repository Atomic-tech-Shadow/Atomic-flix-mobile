{
  "expo": {
    "name": "Atomic Flix",
    "slug": "atomic-flix-mobile", 
    "version": "3.5.0",
    "orientation": "portrait",
    "extra": {
      "eas": {
        "projectId": "fb66f23b-3bd2-4757-b406-fbc1e5bf6af9"
      }
    },
    "icon": "./assets/atomic-flix-logo-new.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#8B5DFF",


    "android": {
      "versionCode": 350,
      "adaptiveIcon": {
        "foregroundImage": "./assets/atomic-flix-logo-new.png",
        "backgroundColor": "#8B5DFF"
      },
      "package": "com.atomicflix.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./android-manifest-config.js", 
      "./android-resources-config.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/atomic-flix-logo-new.png",
          "color": "#8B5DFF",
          "defaultChannel": "atomic-flix-trending",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8B5DFF",
          "image": "./assets/atomic-flix-logo-new.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ]
  }
}
