{
  "expo": {
    "name": "Atomic Flix",
    "slug": "comatomicflix", 
    "version": "1.0.1",
    "orientation": "portrait",
    "extra": {
      "eas": {
        "projectId": "da51d40c-3616-40a7-8748-922a59085fff"
      }
    },
    "icon": "./assets/atomic-flix-logo-new.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#8B5DFF",


    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/atomic-flix-logo-new.png",
        "backgroundColor": "#8B5DFF"
      },
      "package": "com.atomic.flix",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "icon": "./assets/notification-icon-96x96.png",
      "color": "#ffffff"
    },
    "plugins": [
      "./android-manifest-config.js", 
      "./android-resources-config.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon-96x96.png",
          "color": "#ffffff",
          "defaultChannel": "atomic-flix-main",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true,
          "iosDisplayInCarPlay": true,
          "androidMode": "default",
          "androidCollapsedTitle": "%(notification_count) nouvelles notifications"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8B5DFF",
          "image": "./assets/atomic-flix-logo-new.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ]
  }
}
