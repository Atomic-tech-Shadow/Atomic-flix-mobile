{
  "expo": {
    "name": "ATOMIC FLIX",
    "slug": "atomic-flix-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/atomic-flix-logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atomicflix.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/atomic-flix-logo.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.atomicflix.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./android-manifest-config.js",
      "./android-resources-config.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e5b84028-0715-4bc5-861b-a2bfd28a99e9"
      }
    }
  }
}