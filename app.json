{
  "expo": {
    "name": "ATOMIC FLIX",
    "slug": "atomic-flix-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/atomic-flix-logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash/splash-design.png",
      "resizeMode": "cover",
      "backgroundColor": "#0a0a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atomicflix.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/atomic-flix-logo.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.atomicflix.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "splash": {
        "image": "./assets/splash/splash-design.png",
        "resizeMode": "cover",
        "backgroundColor": "#0a0a1a",
        "mdpi": "./assets/splash/splash-design.png",
        "hdpi": "./assets/splash/splash-design.png",
        "xhdpi": "./assets/splash/splash-design.png",
        "xxhdpi": "./assets/splash/splash-design.png",
        "xxxhdpi": "./assets/splash/splash-design.png"
      },
      "screenOrientation": "portrait"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./android-manifest-config.js",
      "./android-resources-config.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0623f722-2262-4443-b8bc-65a795ec2fb3"
      }
    }
  }
}