{
  "expo": {
    "name": "Atomic Flix",
    "slug": "atomic-flix",
    "version": "2.0.0",
    "orientation": "portrait",
    "extra": {
      "eas": {
        "projectId": "6e1fff1f-d2c0-42cf-b4be-238c665a3fd5"
      }
    },
    "icon": "./assets/atomic-flix-logo-new.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F0F",
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/atomic-flix-logo-new.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.atomic.flix",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "icon": "./assets/notification-icon-96x96.png",
      "color": "#ffffff"
    },
    "updates": {
      "url": "https://u.expo.dev/6e1fff1f-d2c0-42cf-b4be-238c665a3fd5",
      "fallbackToCacheTimeout": 30000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "./android-manifest-config.js",
      "./android-resources-config.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon-96x96.png",
          "color": "#ffffff",
          "defaultChannel": "atomic-flix-main",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true,
          "iosDisplayInCarPlay": true,
          "androidMode": "default",
          "androidCollapsedTitle": "%(notification_count) nouvelles notifications"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F0F",
          "image": "./assets/atomic-flix-logo-new.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "owner": "ghostshadow228",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e1fff1f-d2c0-42cf-b4be-238c665a3fd5"
    },
    "ios": {}
  }
}
