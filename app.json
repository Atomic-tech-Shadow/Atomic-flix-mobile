{
  "expo": {
    "name": "Atomic Flix",
    "slug": "atomic-flix-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/atomic-flix-logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a1a",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atomicflix.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/atomic-flix-logo.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.atomicflix.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./android-manifest-config.js", 
      "./android-resources-config.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a1a",
          "image": "./assets/atomic-flix-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "708179b4-d51c-4287-ab77-13c5f4a42924"
      }
    }
  }
}
