{
  "expo": {
    "name": "Atomic Flix",
    "slug": "atomic-flix",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F0F",
    "primaryColor": "#1A1A1A",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "scheme": "atomicflix",
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android.png",
        "backgroundColor": "#8B5DFF"
      },
      "package": "com.atomic.flix",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "atomicflix"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atomic.flix",
      "buildNumber": "4"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "notification": {
      "icon": "./assets/icon-android.png"
    },
    "plugins": [
      "./android-manifest-config.js",
      "./android-resources-config.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-android.png",
          "defaultChannel": "atomic-flix-main",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true,
          "iosDisplayInCarPlay": true,
          "androidMode": "default",
          "androidCollapsedTitle": "%(notification_count) nouvelles notifications"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F0F",
          "image": "./assets/logo.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ca2e5cdb-0bfd-4a2e-8cbb-a86ed02b68ea"
      }
    }
  }
}
