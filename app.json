{
  "expo": {
    "name": "Atomic Flix",
    "slug": "atomic-flix",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/atomic-flix-logo-new.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F0F",
    "primaryColor": "#1A1A1A",
    "splash": {
      "image": "./assets/atomic-flix-logo-new.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/atomic-flix-logo-new.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.atomic.flix",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atomic.flix",
      "buildNumber": "3"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "notification": {
      "icon": "./assets/notification-icon-384x384.png"
    },
    "plugins": [
      "./android-manifest-config.js",
      "./android-resources-config.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon-384x384.png",
          "defaultChannel": "atomic-flix-main",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true,
          "iosDisplayInCarPlay": true,
          "androidMode": "default",
          "androidCollapsedTitle": "%(notification_count) nouvelles notifications"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F0F",
          "image": "./assets/atomic-flix-logo-new.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "020823fa-07b8-4be7-ac79-cca146c5fde6"
      }
    }
  }
}
